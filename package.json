{
  "name": "toss-invest-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Toss Invest Open API auto-trading dashboard for adaptive US stock and ETF strategies.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "research:v2": "node research/v2-strategy-backtest.mjs --output research/results/v2-strategy-backtest-latest.json",
    "research:v2:verify": "node research/verify-v2-strategy-backtest.mjs",
    "test:security": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
